# ==============================================================================
# Verisett AI — Production Environment Variables Template
# Copy this file to .env.local for local development or set in your hosting provider
# (e.g. Vercel / Netlify / AWS Amplify / Railway / Docker).
# ==============================================================================

# 1. Custom Domain & Production URL
# Replace with your purchased domain (e.g., https://verisett.com or https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=https://verisett.com

# 2. NextAuth Authentication
# NEXTAUTH_URL should match your production domain or http://localhost:3000 for local dev
NEXTAUTH_URL=https://verisett.com
# Generate a secure 32+ character random secret (e.g., openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_cryptographic_secret_32bytes_minimum

# 3. Internal Security Token
# Protects internal administrative/rendering routes (e.g. /api/save-video)
INTERNAL_DEV_SECRET=your_internal_secure_api_secret_token

# 4. Google Cloud Console OAuth 2.0 Credentials
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 5. Supabase Authentication & Database
# Obtain from https://supabase.com/dashboard/project/<your-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-jwt-key
SUPABASE_ANON_KEY=your-supabase-public-anon-jwt-key
